# Judge0 (RapidAPI or compatible endpoint) — server-side only, never expose in Vite env
JUDGE0_API_KEY=
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# Optional: only if the frontend is served from a different origin than /api
# VITE_API_BASE=

# Optional (advanced): if you run `vite` on 5173 AND `vercel dev` on another port
# CODESPACE_DEV_API_PROXY=http://127.0.0.1:3000

# Supabase (client-side publishable key only — set real values in .env.local)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
